# Copy this file to .env.local and fill in the values.

# --- Required: Supabase (free tier is enough) ---------------------------------
# Local:  run `npx supabase start` and copy the "Project URL" and "Publishable" key it prints.
# Hosted: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: Anthropic (paid) ------------------------------------------------
# Leave empty to run the intake chat in demo mode (a scripted companion, free).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
ANTHROPIC_MODEL=

# --- Optional -------------------------------------------------------------------
# Shown on the Contact / Privacy / Terms links. Default: the GitHub issues page.
NEXT_PUBLIC_CONTACT_EMAIL=
# Jitsi server for voice calls. Default: meet.jit.si (public, limited embeds).
NEXT_PUBLIC_JITSI_DOMAIN=
